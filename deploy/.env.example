# Copy to deploy/.env and fill in. The compose file is the same on every machine; only this file differs.
# Avoid "$" in the values (docker compose reads it as a variable).

#region ---------------- this machine ---------------------------------------------
# The domain of the panel (HTTPS by itself once its DNS points here), or :80 (dev machine, or no domain yet).
SITE_ADDRESS=:80

# Images: the version to run (./release.sh prints it; ./ship.sh sets it on the server), and where they come from:
# empty on the dev machine (built here), 127.0.0.1:5000/ on the server (its own registry).
TAG=latest
REGISTRY=
# vpn: the VPN exit (once vpn/ has this machine's config); the server also: registry → COMPOSE_PROFILES=vpn,registry
COMPOSE_PROFILES=

# A machine with an NVIDIA GPU: COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml

# Below the VPN tunnel's MTU when the whole machine is behind a VPN (the dev machine: 1380); the server: 1500.
NETWORK_MTU=1500
#endregion

#region ---------------- databases and queue ------------------------------------------
# Postgres: both databases (Transport, Tarabari) use this user.
DB_USERNAME=postgres
DB_PASSWORD=

# RabbitMQ (between the two backends)
RABBITMQ_USER=trabot
RABBITMQ_PASSWORD=
#endregion

#region ---------------- each backend's files (paths from this folder) -------------------------
# Defaults: config/ and data/ in this folder (the server). The dev machine points at the projects' own files.
TRANSPORT_ENV=./config/transport.env
TRANSPORT_KEYS=./config/transport-keys
TRANSPORT_UPLOADS=./data/transport/uploads
TRANSPORT_PRIVATE_UPLOADS=./data/transport/private-uploads
TARABARI_ENV=./config/tarabari.env
TARABARI_KEYS=./config/tarabari-keys
TARABARI_UPLOADS=./data/tarabari/uploads
# log files of each app (one per messenger + app + error); LOG_CONSOLE: error (default), all or off
TRANSPORT_LOGS=./data/transport/logs
TARABARI_LOGS=./data/tarabari/logs
LOG_CONSOLE=error
# Nightly backups: where (keep it off the system disk if the machine has another), when, how many days
BACKUP_DIR=./data/backups
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# Eitaa's gateway settings (APP_BASIC_AUTH, APP_MASTER_KEY, EITAA_ENABLED, BALE_*)
GOOMNI_ENV=./config/goomni.env
#endregion

#region ---------------- VPN exit for Telegram, WhatsApp, OpenAI ------------------------------
# wireguard (vpn/wireguard/wg0.conf) or openvpn (vpn/openvpn/custom.ovpn). A config made for this machine only:
# the same config on two machines keeps cutting both off.
VPN_TYPE=wireguard
WIREGUARD_MTU=1280
OPENVPN_USER=
OPENVPN_PASSWORD=
#endregion

#region ---------------- building (dev machine only) --------------------------------------
TRANSPORT_SRC=..
TARABARI_SRC=../../tarabari_backend
FRONT_SRC=../../transport_front
# Mirrors if npm or Debian are out of reach (Debian e.g. https://mirror.arvancloud.ir)
NPM_REGISTRY=https://registry.npmjs.org/
DEBIAN_MIRROR=http://deb.debian.org
#endregion
