[
  {
    "why": "«ثبت کن» با «سخت کن» هم‌آواست؛ در دستورهای این برنامه «سخت کن» معنی ندارد",
    "from": "(^|\\s)سخت(\\s*)(کن|بکن|کنید|بکنید)(?=$|[\\s.،!؟])",
    "to": "$1ثبت$2$3"
  },
  {
    "why": "«شش هزار» در گفتار محاوره «شیش زار» شنیده می‌شود",
    "from": "(^|\\s)(یک|یه|دو|سه|چهار|پنج|شش|شیش|هفت|هشت|نه|ده|صد|[0-9۰-۹]+)\\s*زار(?=تون|\\s|$|[.،])",
    "to": "$1$2 هزار"
  },
  {
    "why": "«هزار تن» به «هزارتون» چسبیده شنیده می‌شود",
    "from": "هزار\\s*تون(?=$|[\\s.،!؟])",
    "to": "هزار تن"
  }
]
