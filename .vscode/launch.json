{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
          {
      "type": "node",
      "request": "launch",
      "name": "Debug NestJS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      // the server runs the bots and the WhatsApp/Eitaa accounts; two copies of one bot or session cut each other off
      "env": {
        "TELEGRAM_BOT_TOKEN": "",
        "BALE_BOT_TOKEN": "",
        "RUBIKA_BOT_TOKEN": "",
        "EITAA_GOOMNI_URL": "",
        "WHATSAPP_ENABLED": "off"
      },
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },

        {
            "name": "Attach",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        }
    ]
}